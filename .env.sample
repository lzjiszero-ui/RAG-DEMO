# ==================== 基础服务 ====================
# Ollama API 地址，例如本机默认地址；请在 .env 中填写实际值。
OLLAMA_URL=
# 日志级别，可选 DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=
# Qdrant HTTP API 地址；请在 .env 中填写实际值。
QDRANT_URL=

# ==================== 模型 ====================
# 将文档和问题转换成 Dense Vector 的 Ollama Embedding 模型名称。
EMBEDDING_MODEL=
# 执行上下文生成、问题改写、Agent 和最终回答的聊天模型名称。
CHAT_MODEL=

# ==================== Contextual Retrieval ====================
# 是否在导入时为每个切片生成短上下文，可填写 true 或 false。
CONTEXTUAL_RETRIEVAL=
# 生成切片上下文时允许提供给模型的最大文档字符数。
CONTEXTUAL_MAX_DOCUMENT_CHARS=

# ==================== Query Rewrite 与 Agent ====================
# 问题改写时是否开启 reasoning，可填写 true 或 false。
QUERY_REWRITE_REASONING=
# Agent 规划和选择工具时是否开启 reasoning，可填写 true 或 false。
AGENT_REASONING=
# 单次 Agent 问答最多允许执行的工具调用轮数。
AGENT_MAX_STEPS=
# 每个会话最多保留的历史问答轮数。
MAX_HISTORY_TURNS=

# ==================== Qdrant 与检索 ====================
# 本项目使用的 Qdrant Collection 名称。
COLLECTION_NAME=
# 检索模式，可选 vector、bm25、hybrid、hybrid_rerank。
RETRIEVAL_MODE=
# 最终提供给回答模型的参考切片数量。
TOP_K=
# 第一阶段从 Qdrant 召回的候选切片数量。
RETRIEVAL_K=
# Dense Vector 检索的最低相似度阈值。
SCORE_THRESHOLD=
# Cross-Encoder Reranker 模型名称。
RERANKER_MODEL=

# ==================== 文档切片 ====================
# 单个文本切片的目标最大字符数。
CHUNK_SIZE=
# 相邻切片期望重叠的字符数。
CHUNK_OVERLAP=

# ==================== 前台知识导入 ====================
# 前台上传单个文件允许的最大体积，单位 MB。
MAX_UPLOAD_MB=
# 通过 URL 抓取单个网页允许的最大响应体积，单位 MB。
MAX_WEB_PAGE_MB=
# 后台导入失败时的总尝试次数，包含首次执行。
IMPORT_MAX_ATTEMPTS=
# 每次自动重试前等待的秒数。
IMPORT_RETRY_DELAY_SECONDS=
